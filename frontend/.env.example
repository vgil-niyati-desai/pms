# The frontend has one setting. It is read when `npm run dev` starts and baked
# in when `npm run build` runs, so change it before building, not after.
#
# VITE_API_BASE_URL  optional for local development (defaults to
#                    http://localhost:8000 when unset); mandatory to set
#                    deliberately for a production build.
#
# Local Vite development calls the local FastAPI server directly.
VITE_API_BASE_URL=http://localhost:8000

# For a same-origin deployment behind a reverse proxy, serve the API under a
# prefix and point this at it, for example:
#   VITE_API_BASE_URL=/api
# with the proxy stripping /api before forwarding to the backend. A prefix is
# needed because several API routes (/documents, /projects, /tenders, ...) have
# the same path as a page in the app, so a bare "same origin" would send a
# browser refresh on those pages to the API. See "Deploying to a Linux server"
# in README.md.
# VITE_API_BASE_URL=/api
