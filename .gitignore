# ---------------------------------------------------------------------------
# Secrets and local configuration
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
# Local assistant/editor configuration (per-developer permissions, not project code)
.claude/

# Google Drive OAuth credentials and local tokens
**/client_secret*.json
**/credentials*.json
**/*token*.json
**/.google-drive/

# ---------------------------------------------------------------------------
# Python (backend, scripts/pdf_splitter)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
pip-wheel-metadata/
build/
develop-eggs/
downloads/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
*.egg
.installed.cfg
MANIFEST

# Test / coverage / type-checker caches
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.cache/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# ---------------------------------------------------------------------------
# Node / Vite (frontend)
# ---------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
*.local
.eslintcache
.oxlintcache
.npm/
.yarn/
.pnp.*

# ---------------------------------------------------------------------------
# Logs
# ---------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---------------------------------------------------------------------------
# Runtime data (user-uploaded and generated documents)
# ---------------------------------------------------------------------------
backend/app/uploads/*
!backend/app/uploads/.gitkeep
scripts/pdf_splitter/output/
scripts/pdf_splitter/column_map.json

# Local databases / dumps
*.sqlite
*.sqlite3
*.db
dump/

# ---------------------------------------------------------------------------
# Editors and IDEs
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~

# ---------------------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------------------
# Temporary files
# ---------------------------------------------------------------------------
tmp/
temp/
*.tmp
*.bak
*.orig
*.rej

# ---------------------------------------------------------------------------
# Data and credentials that must never be committed
#
# The repository holds code only. Real records, source documents, import
# packages, database exports and tokens live outside it (or are ignored here).
# ---------------------------------------------------------------------------
data_import/
*.zip
*.rar
*.7z
*.bson
*.bson.gz
*.archive
backups/
import_reports/
ocr_cache/
*.token
