# Copy this file to .env and fill in your own values.
# .env should never be committed to version control.
#
# Which settings matter:
#   Local development   nothing here is mandatory. Every value has a working
#                       default, so an unchanged copy of this file runs against
#                       a default local MongoDB.
#   Any deployment      MANDATORY to set explicitly:
#                         MONGO_HOST / MONGO_PORT (or MONGO_URI), MONGO_USER and
#                         MONGO_PASSWORD when MongoDB authentication is on,
#                         MONGO_DB_NAME,
#                         PMS_COOKIE_SECURE=true (the site must be served over HTTPS),
#                         PMS_RATE_LIMIT_SECRET when more than one worker runs.
#                       Set PMS_ALLOWED_ORIGINS if the frontend is on a different
#                       origin from the API.
#   Everything else is OPTIONAL tuning, shown commented out with its default.

# --- MongoDB ---------------------------------------------------------------
# A default local MongoDB install needs no username or password: leave
# MONGO_USER and MONGO_PASSWORD empty and the rest of these defaults work
# as-is. The database and collection are created automatically on first save.
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin
MONGO_DB_NAME=doc_collection_dev
# The document log: every uploaded file's record, including company documents.
MONGO_COLLECTION=documents
# Projects live in their own collection in the same database.
MONGO_PROJECTS_COLLECTION=projects
MONGO_EMPLOYEES_COLLECTION=employees
MONGO_TENDERS_COLLECTION=tenders
# Reusable proposal write-ups (the Proposal Library) have their own collection.
MONGO_PROPOSAL_LIBRARY_COLLECTION=proposal_library
# Accounts, login sessions and the login rate-limit counters.
MONGO_USERS_COLLECTION=users
MONGO_SESSIONS_COLLECTION=sessions
MONGO_LOGIN_THROTTLE_COLLECTION=login_throttle

# How long to wait for the server before giving up. Kept short so an
# unreachable MongoDB reports an error instead of appearing to hang.
MONGO_TIMEOUT_MS=3000

# --- authentication ------------------------------------------------------
# Local development only. Set PMS_COOKIE_SECURE=true on every HTTPS deployment.
# Same-site HTTPS deployments should leave SameSite at strict.
# MANDATORY in production: set true. false is for plain-HTTP local development.
PMS_COOKIE_SECURE=false
PMS_COOKIE_SAMESITE=strict
PMS_SESSION_HOURS=8
# Set the deployed frontend origin when it is on a different origin from the API.
# Same-origin frontend/API deployments do not require CORS entries.
# PMS_ALLOWED_ORIGINS=https://pms.example.com

# --- login rate limiting --------------------------------------------------
# Secret used to HMAC the IP addresses and usernames stored in the
# login_throttle collection, so neither is ever written in plain text.
# Required to be the SAME value on every worker and every instance -- that is
# what lets their failure counters agree with each other. If left unset, a
# random value is generated per process, which only works for a single
# worker; set this explicitly before running more than one.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# PMS_RATE_LIMIT_SECRET=
#
# All of the below have working defaults; override only to tune them.
# Hard limits -- exceeding either returns 429 with Retry-After:
# PMS_LOGIN_IP_MAX_FAILURES=20
# PMS_LOGIN_IP_WINDOW_MINUTES=15
# PMS_LOGIN_IPUSER_MAX_FAILURES=5
# PMS_LOGIN_IPUSER_WINDOW_MINUTES=15
# Soft, username-wide delay -- never blocks, only slows repeated failures
# against one account coming from many different IPs:
# PMS_LOGIN_USER_SOFT_THRESHOLD=15
# PMS_LOGIN_USER_WINDOW_MINUTES=60
# PMS_LOGIN_USER_SOFT_DELAY_STEP_SECONDS=0.25
# PMS_LOGIN_USER_SOFT_DELAY_CAP_SECONDS=4.0
# How long a hard-limit reservation is held before it self-expires if the
# worker handling it never releases it (e.g. a crash). Comfortably above
# normal login latency; this is what bounds a crash's effect to a few
# seconds rather than the rest of the window.
# PMS_LOGIN_RESERVATION_LEASE_SECONDS=10

# Set this only for a connection the host/port fields can't express —
# a replica set, or a MongoDB Atlas cluster. When set, it wins over
# everything above except MONGO_DB_NAME / MONGO_COLLECTION.
# MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/

# --- OCR ------------------------------------------------------------------
# Automatic redaction reads scanned pages and images with Tesseract, which is
# linked into PyMuPDF and runs inside the API process -- nothing is installed
# system-wide and nothing needs to be on PATH. The language data ships with
# the project in backend/ocr/tessdata/, which is used by default.
#
# Set this only to point somewhere else: a shared volume, or a folder with a
# different or additional .traineddata set. Deliberately not TESSDATA_PREFIX,
# which is global to every Tesseract on the machine.
# PMS_TESSDATA_DIR=/srv/shared/tessdata
